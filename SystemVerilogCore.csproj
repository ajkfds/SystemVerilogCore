<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SystemVerilogCore</RootNamespace>
  </PropertyGroup>

  <!-- No package references on purpose: this assembly is the UI-free contract
       that the VS Code language server consumes. It must not pull in Avalonia
       (or any other UI stack) so that the LSP can be hosted in a plain process.
       It previously referenced AvaloniaUI.DiagnosticsSupport while containing
       no Avalonia code at all, which dragged the whole Avalonia dependency
       graph into the bundled server. -->

</Project>
